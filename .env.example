# 루트 .env — docker compose 가 자동 로드 (Git 커밋 금지, .env.example 만 커밋)
#
# 로컬만: backend + frontend
#   docker compose up --build backend frontend
#
# api.monenon.cloud 터널 포함:
#   docker compose --profile tunnel up -d

# Cloudflare Zero Trust → Tunnels → 토큰 복사
CLOUDFLARE_TUNNEL_TOKEN=

# 선택 — DB·Neo4j 비밀번호 (기본값 monenon2026)
# POSTGRES_PASSWORD=
# NEO4J_PASSWORD=

# 선택 — Docker 프론트 빌드 args
# NEXT_PUBLIC_API_BASE_URL=https://api.monenon.cloud
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
