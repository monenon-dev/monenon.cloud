# 루트 .env — docker compose 가 자동 로드 (Git 커밋 금지, .env.example 만 커밋)
#
# 로컬만: backend + frontend
#   docker compose up --build backend frontend
#
# api.monenon.cloud 터널 포함:
#   docker compose --profile tunnel up -d
#
# 2단계 네오:  scripts/phase2-neo.ps1
# 2단계 시그마: 시그마 우분투 Docker Engine에서
#   bash scripts/phase2-sigma.sh
# (Docker Desktop 불필요. Windows PowerShell의 docker 는 쓰지 말 것)

# Cloudflare Zero Trust → Tunnels → 토큰 복사 (네오·시그마 동일 토큰 = 이중 커넥터)
CLOUDFLARE_TUNNEL_TOKEN=

# 2단계 시그마 전용 — 네오 PC의 LAN IP (ipconfig → IPv4)
# NEO_HOST=192.168.0.10

# Hub 이미지 (기본 whtjgml2002/monenon-backend:latest)
# BACKEND_IMAGE=whtjgml2002/monenon-backend:latest

# 선택 — DB·Neo4j 비밀번호 (기본값 monenon2026, 네오·시그마 동일하게)
# POSTGRES_PASSWORD=
# NEO4J_PASSWORD=

# 선택 — Docker 프론트 빌드 args
# NEXT_PUBLIC_API_BASE_URL=https://api.monenon.cloud
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_NAVER_CLIENT_ID=
# NEXT_PUBLIC_KAKAO_CLIENT_ID=
# NEXT_PUBLIC_OAUTH_REDIRECT_ORIGIN=https://monenon.cloud
# (또는 Vercel 서버 라우트용 NAVER_CLIENT_ID / KAKAO_CLIENT_ID)
