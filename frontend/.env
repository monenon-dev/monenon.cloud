# Vercel: Project → Settings → Environment Variables (Production·Preview 모두)
# 백엔드(FastAPI) 공개 URL — 끝에 / 없이
# 프로덕션 값은 Vercel 대시보드(NEXT_PUBLIC_API_BASE_URL)가 단일 출처.
# 로컬은 미설정 시 lib/api-base.ts 가 http://127.0.0.1:8000 으로 폴백하므로 비워 둔다.
# 로컬에서 다른 백엔드를 쓰려면 .env.local 에 NEXT_PUBLIC_API_BASE_URL 을 지정.
# NEXT_PUBLIC_API_BASE_URL=
# backend/.env GOOGLE_CLIENT_ID 와 동일
NEXT_PUBLIC_GOOGLE_CLIENT_ID=919302643436-m74hkqc8hkqgckqfgcr0h5fci9r74qsp.apps.googleusercontent.com
# backend/.env NAVER_CLIENT_ID / KAKAO_CLIENT_ID 와 동일 (공개값 — Vercel 빌드·OAuth 시작 라우트)
NEXT_PUBLIC_NAVER_CLIENT_ID=0CpM2KmaSEktVO7sUYtb
NEXT_PUBLIC_KAKAO_CLIENT_ID=42603bba4006609e87b4207a5a1e5d7d
# 네이버·카카오 개발자 콘솔 Callback/Redirect URI 와 동일 origin
NEXT_PUBLIC_OAUTH_REDIRECT_ORIGIN=https://www.monenon.cloud
