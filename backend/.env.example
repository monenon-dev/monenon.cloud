# Neon 콘솔 Connection string (postgresql://...) — core/database.py가 postgresql+psycopg:// 로 자동 변환
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Seoul

# Google OAuth (프론트 NEXT_PUBLIC_GOOGLE_CLIENT_ID와 동일한 Web Client ID)
GOOGLE_CLIENT_ID=

# Naver / Kakao OAuth — 시크릿은 백엔드만. 프론트(Vercel)에는 CLIENT_ID만
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_REDIRECT_URI=http://localhost:3000/api/auth/callback/naver
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/callback/kakao
# OAUTH_REDIRECT_ORIGINS=http://localhost:3000,https://www.monenon.cloud,https://monenon.cloud

# Vercel 프론트 URL (쉼표 구분, 커스텀 도메인 포함)
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# Vercel Blob — Next.js /api/blob/pdf
# 로컬·Docker: frontend/.env.local → BLOB_READ_WRITE_TOKEN (development OIDC 미지원)
# Vercel 배포: BLOB_STORE_ID + OIDC 자동
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# ── PoC 로컬 Hub (단일 Qwen — 입구 분류 + RAG hub/spoke) ─────────────────────
# 시맨틱 라우터에 QLoRA는 필수가 아님. 프롬프트+allowlist로 충분.
OLLAMA_BASE_URL=http://172.17.0.1:11434
POC_HUB_MODEL=qwen2.5:1.5b-instruct
OLLAMA_MODEL=qwen2.5:1.5b-instruct
MONEYBALL_HUB_MODEL=qwen2.5:1.5b-instruct
MONEYBALL_SPOKE_MODEL=qwen2.5:1.5b-instruct
STAR_CRAFT_HUB_MODEL=qwen2.5:1.5b-instruct
GATEWAY_INTENT_BACKEND=local
GATEWAY_HUB_MODEL=qwen2.5:1.5b-instruct
MONEYBALL_LLM_MODE=ollama
REDIS_URL=redis://redis:6379/0
