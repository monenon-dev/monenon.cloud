# Auth 게이트웨이 전용 (JWT 개인키·OAuth 시크릿)
# 복사: cp backend/.env.auth.example backend/.env.auth
# 키 생성: bash scripts/generate_jwt_keys.sh

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://postgres:monenon2026@pgvector:5432/monenon
SERVICE_AUD=monenon-api

# PEM 원문(\\n) 또는 base64 한 줄 — scripts/generate_jwt_keys.sh 참고
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=monenon-auth-1
JWT_ACCESS_TTL_MIN=10
JWT_REFRESH_TTL_DAYS=14

GOOGLE_CLIENT_ID=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
